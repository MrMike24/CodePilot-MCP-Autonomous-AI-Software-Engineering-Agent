# CodePilot-MCP Environment Configuration
APP_NAME=CodePilot-MCP
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API & Host
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./codepilot.db

# GitHub Integration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_DEFAULT_OWNER=MrMike24
GITHUB_DEFAULT_REPO=CodePilot-AI-Engineering

# LLM / AI Model Provider
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# MCP Settings
ALLOWED_HOST_WORKSPACE_ROOT=./demo_repository
